PORT=4000
NODE_ENV=production
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Database Configuration (SQLite local dev vs Supabase PostgreSQL production)
DATABASE_PATH=./data/cococraft.db
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Shipping Rules (Paise: ₹1,500 = 150000, ₹99 = 9900)
FREE_SHIPPING_THRESHOLD_PAISE=150000
STANDARD_SHIPPING_PAISE=9900
