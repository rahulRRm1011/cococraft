{
  "name": "cococraft-server",
  "version": "1.0.0",
  "description": "Express.js API Layer for CocoCraft Sustainable Coconut-Shell Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx scripts/create-admin.ts",
    "inventory:seed": "tsx scripts/seed-inventory.ts",
    "db:migrate:supabase": "tsx scripts/migrate-sqlite-to-supabase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^11.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
